{
  "name": "@sanity/workbench-cli",
  "version": "2.11.0",
  "description": "Internal implementation detail of the Sanity CLI's unstable workbench support. Not intended for direct use.",
  "homepage": "https://github.com/sanity-io/cli",
  "bugs": "https://github.com/sanity-io/cli/issues",
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/cli.git",
    "directory": "packages/@sanity/workbench-cli"
  },
  "files": [
    "./dist",
    "!./dist/**/__tests__"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/_exports/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/_exports/index.ts",
      "default": "./dist/_exports/index.js"
    },
    "./build": {
      "source": "./src/_exports/build.ts",
      "default": "./dist/_exports/build.js"
    },
    "./deploy": {
      "source": "./src/_exports/deploy.ts",
      "default": "./dist/_exports/deploy.js"
    },
    "./dev": {
      "source": "./src/_exports/dev.ts",
      "default": "./dist/_exports/dev.js"
    },
    "./init": {
      "source": "./src/_exports/init.ts",
      "default": "./dist/_exports/init.js"
    },
    "./preview": {
      "source": "./src/_exports/preview.ts",
      "default": "./dist/_exports/preview.js"
    },
    "./_internal_render": {
      "source": "./src/_exports/_internal_render.ts",
      "default": "./dist/_exports/_internal_render.js"
    },
    "./_internal_worker_bus": {
      "source": "./src/_exports/_internal_worker_bus.ts",
      "default": "./dist/_exports/_internal_worker_bus.js"
    },
    "./undeploy": {
      "source": "./src/_exports/undeploy.ts",
      "default": "./dist/_exports/undeploy.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@module-federation/runtime": "2.9.2",
    "@module-federation/vite": "1.23.4",
    "@sanity/cli-core": "^3.9.2",
    "@sanity/sdk": "^3.8.0",
    "@sanity/types": "^6.17.0",
    "@vitejs/plugin-react": "^6.1.2",
    "form-data": "^4.0.5",
    "rxjs": "^7.8.2",
    "semver": "^7.8.1",
    "tar": "^7.5.18",
    "vite": "^8.3.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@repo/package.config": "0.0.1",
    "@repo/tsconfig": "3.70.0",
    "@sanity/cli-test": "19.0.2",
    "@sanity/eslint-config-cli": "^1.1.3",
    "@sanity/pkg-utils": "^12.3.4",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "publint": "^0.3.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "swc --delete-dir-on-start --strip-leading-paths --out-dir dist/ src",
    "build:types": "pkg-utils build --emitDeclarationOnly",
    "check:types": "tsc --noEmit",
    "lint": "eslint .",
    "publint": "publint",
    "test": "vitest run",
    "posttest": "pnpm run lint",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "watch": "swc --delete-dir-on-start --strip-leading-paths --out-dir dist/ --watch src"
  }
}