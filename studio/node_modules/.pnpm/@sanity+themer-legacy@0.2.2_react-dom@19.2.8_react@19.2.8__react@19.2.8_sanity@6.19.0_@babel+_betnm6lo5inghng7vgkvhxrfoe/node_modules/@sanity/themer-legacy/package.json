{
  "name": "@sanity/themer-legacy",
  "version": "0.2.2",
  "description": "The hosted Themer service (themer.sanity.build) as an npm package: the exact same Sanity Studio theme generator, running locally, and a Studio tool to edit its themes.",
  "keywords": [
    "sanity",
    "studio",
    "theme",
    "themer",
    "ui"
  ],
  "homepage": "https://www.sanity.io/",
  "bugs": {
    "url": "https://github.com/sanity-io/themer/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/themer.git",
    "directory": "packages/themer-legacy"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./tool": "./dist/tool.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@sanity/color": "^3.0.8",
    "@sanity/icons": "^5.2.2",
    "@sanity/ui": "^4.2.7",
    "react-compiler-runtime": "1.0.0"
  },
  "devDependencies": {
    "@sanity/tsdown-config": "^0.28.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "oxc-transform-react": "^0.151.0",
    "react": "^19.3.0",
    "rimraf": "^5.0.5",
    "sanity": "^6.16.0",
    "styled-components": "^6.5.3",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "sanity": "^3 || ^4 || ^5 || ^6",
    "styled-components": "^5.2 || ^6"
  },
  "peerDependenciesMeta": {
    "sanity": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsdown --watch"
  }
}