{
  "name": "@sanity/workflow-blueprint",
  "version": "0.36.0",
  "description": "Public Sanity Blueprints authoring, generation, and generated runtime support for Workflows.",
  "keywords": [
    "blueprints",
    "sanity",
    "sanity-io",
    "workflow",
    "workflows"
  ],
  "homepage": "https://github.com/sanity-io/workflows/tree/main/packages/workflow-blueprint#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/workflows/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/workflows.git",
    "directory": "packages/workflow-blueprint"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./generate": {
      "import": "./dist/generate.js",
      "require": "./dist/generate.cjs",
      "default": "./dist/generate.js"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs",
      "default": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sanity/client": "^7.24.0"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.21.0",
    "@sanity/functions": "^1.7.2",
    "@sanity/pkg-utils": "^10.5.2",
    "@types/node": "^25.9.1",
    "groq-js": "^1.30.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@sanity/workflow-engine-test": "0.36.0",
    "@sanity/workflow-examples": "0.12.4",
    "@sanity/workflow-engine": "0.36.0",
    "@sanity/workflow-test-fixtures": "0.0.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3 || ^7.0.0",
    "@sanity/workflow-engine": "0.36.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pkg-utils build --clean",
    "docs": "node ../../scripts/run-typedoc.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}