{
  "name": "@sanity/themer",
  "version": "0.10.4",
  "description": "Generate Sanity Studio themes, and preview them with a Studio tool.",
  "keywords": [
    "sanity",
    "studio",
    "theme",
    "themer",
    "ui"
  ],
  "homepage": "https://github.com/sanity-io/plugins/tree/main/plugins/%40sanity/themer#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/plugins/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/plugins.git",
    "directory": "plugins/@sanity/themer"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/tool.js",
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "imports": {
    "#constants": "./src/tool/constants.ts",
    "#context": "./src/tool/context.ts",
    "#reducer": "./src/tool/reducer.ts",
    "#types": "./src/tool/types.ts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./legacy": "./dist/legacy.js",
    "./tool": "./dist/tool.js",
    "./bundle.css": {
      "types": "./dist/bundle-css.d.ts",
      "browser": "./dist/bundle.css",
      "style": "./dist/bundle.css",
      "node": "./dist/bundle-css.js",
      "default": "./dist/bundle-css.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@sanity/color": "^3.0.9",
    "@sanity/icons": "^5.2.3",
    "@sanity/themer-legacy": "^0.2.2",
    "@sanity/ui": "^4.4.9",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@xstate/react": "^6.1.0",
    "dequal": "^2.0.3",
    "motion": "^14.2.0",
    "react-refractor": "^4.0.0",
    "refractor": "^5.0.0",
    "scroll-into-view-if-needed": "^3.1.0",
    "valibot": "^1.5.0",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@sanity/tsconfig": "^2.2.1",
    "@sanity/tsdown-config": "^0.31.1",
    "@sanity/vanilla-extract-vite-plugin": "^0.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "lightningcss": "^1.33.0",
    "oxc-transform-react": "^0.154.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.18.0",
    "styled-components": "^6.6.0",
    "tsdown": "^0.23.1"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^3 || ^4 || ^5 || ^6"
  },
  "peerDependenciesMeta": {
    "sanity": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "scripts": {
    "build": "tsdown"
  }
