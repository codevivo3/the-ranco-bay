  "files": [
    "dist"
  ],
  "prettier": "@sanity/prettier-config",
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@sanity/pkg-utils": "^10.4.8",
    "@sanity/prettier-config": "^3.0.0",
    "@sanity/schema": "^5.23.0",
    "@sanity/tsconfig": "^2.1.0",
    "@sanity/types": "^5.23.0",
