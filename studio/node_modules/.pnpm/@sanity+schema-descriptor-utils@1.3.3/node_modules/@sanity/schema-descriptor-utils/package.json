    "prettier": "^3.7.4",
    "prettier-plugin-packagejson": "^2.5.20",
    "sanity": "^5.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pkg build --strict --check --clean",
